{
  "handle": "openframe",
  "variant": "5in",
  "content": {
    "product": "openframe",
    "variant": "5\" Freestyle"
  },
  "sources": [
    "public/models/od5/frame.glb",
    "public/models/od5/drive.glb"
  ],
  "camera": {
    "tiltDeg": 12
  },
  "layout": {
    "gapMm": 8,
    "sectionGapMm": 12,
    "aspect": 1.2
  },
  "notes": [
    "Black-Oxide flat head screws belong to the DJI O4 air unit reference model: excluded.",
    "Cam-Mount-L/R (TPU) are not in the box list; the camera mount is the CNC aluminium pair (Standoff-L/R).",
    "VTX-Mount is in the box list but not in the GLB."
  ],
  "groups": [
    {
      "label": "Build card",
      "procedural": {
        "kind": "card",
        "w": 105,
        "h": 148,
        "caption": "OpenFrame 5″ · Build card",
        "illustration": "^(Top|Base-Top|Base-Bot|Arm|Cross)$"
      },
      "row": 1,
      "item": "Build card"
    },
    {
      "label": "Top plate",
      "match": "^Top$",
      "finish": "carbon",
      "row": 1,
      "item": "Carbon plates"
    },
    {
      "label": "Base plates",
      "match": "^Base-(Top|Bot)$",
      "finish": "carbon",
      "row": 1,
      "item": "Carbon plates"
    },
    {
      "label": "Arms",
      "match": "^Arm$",
      "finish": "carbon",
      "row": 2,
      "item": "5\" carbon arms",
      "lay": "x",
      "perRow": 2
    },
    {
      "label": "Camera mount pair",
      "match": "^Standoff-(L|R)$",
      "finish": "alu",
      "color": "#1b1c1f",
      "material": {
        "roughness": 0.55
      },
      "row": 3,
      "item": "CNC aluminium"
    },
    {
      "label": "Arm boots",
      "match": "^Boot-",
      "finish": "tpu",
      "color": "#f2ae00",
      "item": "TPU parts set",
      "perRow": 4,
      "below": "Camera mount pair"
    },
    {
      "label": "Antenna mount",
      "match": "^Airtag/Antenna[- ]mount$",
      "finish": "tpu",
      "color": "#f2ae00",
      "row": 3,
      "item": "TPU parts set"
    },
    {
      "label": "Cross brace",
      "match": "^Cross$",
      "finish": "carbon",
      "item": "Carbon cross",
      "below": "Antenna mount"
    },
    {
      "label": "Standoffs 18 mm",
      "match": "^18mmx4mm$",
      "finish": "alu",
      "color": "#2c2e33",
      "row": 3,
      "item": "Hardware kit"
    },
    {
      "label": "Sticker",
      "procedural": {
        "kind": "sticker",
        "w": 80,
        "h": 22
      },
      "row": 3,
      "item": "Sticker"
    },
    {
      "label": "Anti-slip pad",
      "match": "^anti-slip pad$",
      "finish": "rubber",
      "color": "#1d1e21",
      "lay": "x",
      "decal": {
        "art": "incutec",
        "base": "#1d1e21",
        "widthFrac": 0.5,
        "alpha": 0.85
      },
      "note": "GLB colours are placeholder grey and white; the pad is dark silicone with the Incutec wordmark",
      "item": "Anti-slip",
      "below": "Sticker"
    },
    {
      "label": "Battery straps",
      "procedural": {
        "kind": "strap",
        "w": 20,
        "len": 220
      },
      "count": 2,
      "lay": "x",
      "perRow": 1,
      "row": 4,
      "item": "Battery straps"
    },
    {
      "label": "M3 cup washers",
      "procedural": {
        "kind": "cupWasher",
        "od": 9,
        "h": 2.5,
        "bore": 3.2
      },
      "count": 10,
      "perRow": 5,
      "section": "hardware",
      "item": "Aluminium M3 cup washers",
      "row": 4
    },
    {
      "label": "Soft-mount grommets",
      "match": "^softmount m2$",
      "finish": "rubber",
      "section": "hardware",
      "item": "Hardware kit",
      "perRow": 4
    },
    {
      "label": "M3x6 button head",
      "match": "^Socket button head screw M3x0\\.5 x 6$",
      "finish": "steel",
      "extra": 2,
      "perRow": 10,
      "section": "hardware",
      "item": "Hardware kit",
      "headTo": "z"
    },
    {
      "label": "M3x8 button head",
      "match": "^Socket button head screw M3x0\\.5 x 8$",
      "finish": "steel",
      "extra": 2,
      "perRow": 12,
      "section": "hardware",
      "item": "Hardware kit",
      "headTo": "z"
    },
    {
      "label": "M3x12 button head",
      "match": "^Socket button head screw M3x0\\.5 x 12$",
      "finish": "steel",
      "extra": 2,
      "perRow": 6,
      "section": "hardware",
      "item": "Hardware kit",
      "headTo": "z"
    },
    {
      "label": "M3x20 button head",
      "match": "^Socket button head screw M3x0\\.5 x 20$",
      "finish": "steel",
      "extra": 2,
      "perRow": 6,
      "section": "hardware",
      "item": "Hardware kit",
      "headTo": "z"
    },
    {
      "label": "M3x8 socket cap",
      "match": "^Hex socket head cap screw M3x0\\.50 x 8$",
      "finish": "steel",
      "extra": 2,
      "perRow": 9,
      "section": "hardware",
      "item": "Hardware kit",
      "headTo": "z"
    },
    {
      "label": "M3 locknut",
      "match": "^Prevailing torque nut M3x0\\.5$",
      "finish": "steel",
      "color": "#80868f",
      "section": "hardware",
      "item": "Hardware kit"
    },
    {
      "label": "M3 press nut",
      "match": "^m3 pressnut$",
      "finish": "zinc",
      "perRow": 10,
      "section": "hardware",
      "item": "Hardware kit"
    }
  ],
  "exclude": [
    "^Black-Oxide Alloy Steel Hex Drive Flat Head Screw",
    "^Cam-Mount-(L|R)$",
    "^AirTag$",
    "^Dual-Band-UFL-Antenna$",
    "^Rear Housing:1__Body1$",
    "^Prevailing torque nut M5x0\\.80$",
    "^2306\\.5-2026\\.7\\.14$",
    "^5in-prop c?cw$"
  ]
}
