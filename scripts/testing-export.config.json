{
  "$comment": "Config for scripts/sync-testing.mjs. Figures come from the publish blocks of saved views in the testing repository (Graphs/views/*.json); nothing about a figure is written here. This file holds only the product handle map, the point and size caps, the banned strings and the thrust stand field rules.",
  "schema": 2,
  "maxPoints": 2500,
  "figureBudgetKb": 400,
  "domains": [
    "THR",
    "PWR",
    "THM",
    "RF",
    "CTL"
  ],
  "tiers": [
    "20x20",
    "30x30"
  ],
  "products": {
    "openmotor": {
      "name": "OpenMotor",
      "order": 1
    },
    "openesc": {
      "name": "OpenESC",
      "order": 2
    },
    "openfc-lite": {
      "name": "OpenFC-Lite",
      "order": 3
    },
    "openrx": {
      "name": "OpenRX",
      "order": 4
    },
    "openframe": {
      "name": "OpenFrame",
      "order": 5
    }
  },
  "thrustStand": {
    "runPattern": "^drv-04-",
    "fields": [
      "rpm",
      "thrust_g",
      "thr",
      "v_bus",
      "tesc_max"
    ],
    "bannedFieldPattern": "^(i_a|i_raw|i_shunt|p_shunt|eff_gw|clamp_a|i_clamp|p_bus|i_total|i1)$|power|gw"
  },
  "banned": [
    [
      "\\/Volumes",
      "a local volume path"
    ],
    [
      "Private",
      "the private tree"
    ],
    [
      "siliXcon",
      "a supplier name"
    ],
    [
      "\\bCE\\b",
      "a compliance record"
    ],
    [
      "EN 300",
      "a regulatory standard"
    ],
    [
      "OpenFC-Core",
      "the NDA component"
    ],
    [
      "[\u20ac$\u00a3]\\s?\\d|\\d\\s?(\u20ac|EUR\\b|USD\\b)",
      "a price"
    ],
    [
      "LCSC",
      "a supplier part number source"
    ],
    [
      "\u2014",
      "an em dash"
    ],
    [
      "\\/Users\\/",
      "a home directory path"
    ]
  ]
}
