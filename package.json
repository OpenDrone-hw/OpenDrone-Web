{
  "name": "opendrone-web",
  "private": false,
  "sideEffects": false,
  "version": "2026.1.2",
  "type": "module",
  "license": "MIT",
  "homepage": "https://opendrone.be",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenDrone-hw/OpenDrone-Web.git"
  },
  "bugs": {
    "url": "https://github.com/OpenDrone-hw/OpenDrone-Web/issues"
  },
  "scripts": {
    "prebuild": "npm run sync:legal",
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "npm run build && wrangler dev --config wrangler.production.toml",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test \"app/**/*.test.ts\"",
    "check:registry": "node --experimental-strip-types scripts/check-registry.mjs",
    "check:status": "node --experimental-strip-types scripts/check-status-fallback.mjs",
    "sync:legal": "node scripts/sync-legal.mjs",
    "audit:mobile": "node scripts/mobile-shots.mjs",
    "audit:perf": "node scripts/perf-audit.mjs",
    "audit:lh": "node scripts/lh-audit.mjs",
    "gen:board-art": "node scripts/export-board-art.mjs --all",
    "gen:shopify-templates": "node scripts/shopify-templates/gen.mjs",
    "gen:components": "node scripts/export-board-art.mjs --all --components-only",
    "gen:schematics": "node scripts/export-schematics.mjs --all",
    "studio:tokens": "node scripts/studio-tokens.mjs",
    "studio:products": "node --experimental-strip-types scripts/migrate-product-content.mjs",
    "studio:coverage": "node scripts/studio-coverage.mjs",
    "sync:contributors": "node scripts/sync-contributors.mjs",
    "sync:timeline": "node scripts/sync-timeline.mjs",
    "goals:update": "node scripts/update-goals.mjs",
    "sync:specs": "node scripts/import-specs.mjs --write",
    "sync:downloads": "node scripts/sync-downloads.mjs --check",
    "sync:specs:check": "node scripts/import-specs.mjs --check"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "isbot": "^5.2.2",
    "lucide-react": "^1.44.0",
    "motion": "^12.43.0",
    "postprocessing": "^6.39.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "7.18.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "~7.18.4",
    "@react-router/fs-routes": "~7.18.4",
    "@shopify/prettier-config": "^1.1.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fontkit": "^2.0.4",
    "globals": "^15.14.0",
    "marked": "^18.0.13",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^4.3.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.3"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "qs": "^6.15.3"
  }
}
