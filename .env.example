# OpenDrone storefront — environment variables
# Copy to .env before running `npm run dev`.
#
# Catalog, prices, availability, cart, checkout, orders and customer
# accounts live in Odoo on shop.incutec.com. This app reads one public
# JSON feed and hands every buy click to that shop; it holds no commerce
# credentials at all.

# ---------------------------------------------------------------------------
# Required — storefront cannot boot without this
# ---------------------------------------------------------------------------

# Random string used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="your-session-secret"

# ---------------------------------------------------------------------------
# Commerce backend (optional — both have working defaults)
# ---------------------------------------------------------------------------

# The Incutec shop on Odoo. Base of every buy hand-off
# (a POST form to `<PUBLIC_SHOP_URL>/incutec/add`) and of every portal link
# (/my, /my/orders, /web/login). Also the fallback base when the catalog
# feed is unreachable. Defaults to https://shop.incutec.com.
PUBLIC_SHOP_URL=""

# The Odoo catalog feed (Odoo module incutec_catalog_api): handles,
# titles, images, prices incl. VAT, availability, ship promises, ratings
# and ready-made hand-off links. Public, no authentication. Fetched
# server-side with a 5 minute worker cache; the last good copy serves for
# up to an hour if the fetch fails.
# Defaults to https://erp.incutec.com/incutec/catalog.json.
CATALOG_URL=""

# Optional server-side Basic auth for a protected catalog origin. The
# Cloudflare preview Worker (wrangler.toml) points CATALOG_URL at staging,
# which sits behind auth; production (wrangler.production.toml) leaves
# these unset since the live catalog is public.
CATALOG_HTTP_USER=""
CATALOG_HTTP_PASSWORD=""

# ---------------------------------------------------------------------------
# Legal entity: footer, imprint, invoices.
# WER Art. VI.45 requires these to appear on every page of a BE webshop.
# ---------------------------------------------------------------------------
PUBLIC_COMPANY_NAME="Incutec BV"
PUBLIC_COMPANY_ADDRESS="Stapelhuisstraat 15, 3000 Leuven, Belgium"
PUBLIC_COMPANY_KBO="1038.934.039"   # BCE/KBO enterprise number
PUBLIC_COMPANY_VAT="BE 1038.934.039" # Same digits, BE-prefixed
PUBLIC_COMPANY_EMAIL="contact@opendrone.be"
PUBLIC_COMPANY_TEL="[pending]"      # Optional but recommended

# ---------------------------------------------------------------------------
# Launch switches (optional)
# ---------------------------------------------------------------------------
# Coming-soon kill switch: unset (or anything but "0") renders every product
# as coming soon: no prices, notify-me signup instead of add-to-cart. Set to
# "0" the day orders open. Per-product `status` in content/products/*.json
# wins over this.
# PUBLIC_COMING_SOON="0"

# ---------------------------------------------------------------------------
# Compliance content sync (optional)
# ---------------------------------------------------------------------------
# Override path for `npm run sync:legal`. Defaults to the internal Incutec
# compliance workstream. sync:legal no-ops when the path is unreachable and
# preserves the committed snapshot under app/content/legal/.
# COMPLIANCE_SRC=""

# ---------------------------------------------------------------------------
# Web-support Discord bridge (optional)
# ---------------------------------------------------------------------------
# When DISCORD_BOT_TOKEN + DISCORD_SUPPORT_CHANNEL_ID are set, /contact
# renders a chat widget that creates a thread in the forum channel below.
# See the Support bridge section in README.md for end-to-end setup.

# Discord bot token — keep as a secret, never public.
DISCORD_BOT_TOKEN=""

# Numeric ID of a **Forum** channel the bot can post threads in.
DISCORD_SUPPORT_CHANNEL_ID=""

# Server (guild) ID. Required for the Stage 2 moderation gate below —
# used to resolve which users carry the moderator role.
DISCORD_GUILD_ID=""

# Private staff-only channel for ticket metadata (email, Shopify
# customer id, IP hint, user-agent). When set, the public web-support
# forum thread shows only first-name + subject + message body, and the
# bot fires a companion message with the full PII + a jump-URL into
# THIS channel. Discord-side role permissions on this channel decide
# who can read it — give the same role that gates Stage 2 approvals
# View Channel, deny @everyone. Leave blank to keep the legacy
# "everything in the public thread" behaviour while you set up the
# private channel.
DISCORD_STAFF_METADATA_CHANNEL_ID=""

# Channel for the end-of-ticket customer feedback survey (three 1-5
# ratings + notes), posted by api.support.feedback.tsx via
# lib/support/discord.ts postFeedback(). Falls back to
# DISCORD_STAFF_METADATA_CHANNEL_ID when unset; with neither set,
# feedback is still recorded on the mirrored Odoo ticket but nothing
# posts to Discord.
DISCORD_FEEDBACK_CHANNEL_ID=""

# Stage 2 moderation gate. When SUPPORT_MOD_ROLE_ID is set AND the
# mode below is "enforce", messages in a support thread only reach the
# customer once someone with that Discord role reacts with the approve
# emoji. Leave the role id blank to fall back to the legacy
# "relay everything" behaviour.
SUPPORT_MOD_ROLE_ID=""
# Approve emoji — default is ✅. Any unicode emoji works.
SUPPORT_APPROVE_EMOJI=""
# Gate behaviour. One of:
#   enforce  — only approved messages reach the customer (default once
#              SUPPORT_MOD_ROLE_ID is set).
#   log      — relay everything, log which messages *would* have been
#              held so staff can watch the gate before flipping on.
#   off      — gate fully disabled, no logging. Incident use only.
SUPPORT_MODERATION_MODE=""

# Invite link rendered on the contact page and inside the widget.
DISCORD_SUPPORT_INVITE="https://discord.gg/ABajnacUsS"

# Public-facing guild + invite for the rich /contact invite card. The
# loader hits GET /guilds/{id}?with_counts=true to render online +
# member counts and the description. PUBLIC_DISCORD_GUILD_ID falls back
# to DISCORD_GUILD_ID if unset; PUBLIC_DISCORD_INVITE falls back to
# DISCORD_SUPPORT_INVITE. Set both explicitly when the public card and
# the support bridge use different guilds (e.g. soft-launch / staging).
PUBLIC_DISCORD_GUILD_ID=""
PUBLIC_DISCORD_INVITE="https://discord.gg/ABajnacUsS"

# HMAC key for signing the support-session cookie. Generate with:
#   openssl rand -hex 32
# Falls back to SESSION_SECRET if unset.
SUPPORT_SESSION_SECRET=""

# Cloudflare Turnstile (optional but recommended) — site key is public,
# secret is server-only. Without these the intake form has no CAPTCHA.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Local-dev-only escape hatch: set to "1" when you don't want to run
# Turnstile in development. Has no effect if TURNSTILE_SECRET_KEY is
# also set — it only kicks in when the secret is missing, which would
# otherwise fail closed in production. Never set this in production.
SUPPORT_TURNSTILE_DEV_SKIP=""

# Resend (transactional email). Powers the cross-device "resume by email"
# magic link sent on every new ticket, plus the consolidated ticket-list
# email when a returning user looks up their tickets. When unset, the
# rest of the bridge still works — users just don't get the resume link.
# Free tier: 3,000 emails/month. https://resend.com
RESEND_API_KEY=""
SUPPORT_FROM_EMAIL="support@opendrone.be"

# Marketing email (growth) — the same RESEND_API_KEY also drives
# scripts/launch-blast.mjs, the per-product "notify me at launch" blast
# against a Resend segment (unrelated to the Newsletter list below, which
# moved to Odoo). The key needs access to Resend Contacts/Segments/
# Broadcasts, and the domain of this from-address must be verified in
# Resend. Defaults to hello@opendrone.be when unset.
RESEND_MARKETING_FROM="hello@opendrone.be"

# ---------------------------------------------------------------------------
# Stage 4 AI first-responder (optional)
# ---------------------------------------------------------------------------
# When enabled, every new ticket is routed through Claude to draft a
# reply. The draft is posted INTO THE DISCORD THREAD ONLY — the
# customer never sees it unless a moderator approves it with the
# Stage 2 approve emoji. Leaving SUPPORT_AI_DRAFTS_ENABLED blank
# (or the API key empty) keeps the AI path entirely off.
ANTHROPIC_API_KEY=""
SUPPORT_AI_DRAFTS_ENABLED=""
# Optional model override. Defaults to claude-haiku-4-5 (fast, cheap,
# right-sized for short support triage). Sonnet works if you want
# more nuanced drafts at higher cost.
SUPPORT_AI_MODEL=""

# ---------------------------------------------------------------------------
# Odoo support-ticket mirror, state and lookup (erp PLAN.md step 12.2)
# ---------------------------------------------------------------------------
# Mirrors each Discord support ticket, and every message a visitor sends into
# it, into Odoo project.task (erp/addons/incutec_support), which is also the
# storefront's ticket index: close/cursors/feedback state and email/thread-id
# lookup all go through this bridge (founder decision, 2026-09-15, removed a
# Upstash Redis KV index this used to keep alongside it). See
# app/lib/support/odoo.ts and the bridge contract in that module's README.
# When unset, mirroring and lookup are skipped: the Discord-only bridge still
# works per-device via the signed cookie, but cross-device "list my tickets
# by email" and the reply-notification/cleanup crons have nothing to read
# (D13, docs/storefront-contract.md).
#
# Base URL of the Odoo instance. Defaults to https://erp.incutec.eu.
SUPPORT_ODOO_URL=""
# Shared secret sent as X-Incutec-Support-Token. Must match system parameter
# incutec_support.bridge_token on that Odoo instance (set from env
# SUPPORT_BRIDGE_TOKEN by erp/config/support.py). Keep as a secret.
SUPPORT_ODOO_TOKEN=""

# ---------------------------------------------------------------------------
# OpenBrain ticket store (phase-1 scaffold — NOT wired live)
# ---------------------------------------------------------------------------
# The support backend is migrating from the Discord/Odoo/cookie bridge above
# to OpenBrain's account-bound CRM store (see app/lib/support/openbrain.ts
# and the OpenBrain repo's crm_schema.sql). Until the cut-over,
# SUPPORT_BACKEND stays "discord" (the default) and the live routes are
# unchanged.
#
# SUPPORT_BACKEND: "discord" (default) | "openbrain". Only takes effect as
# "openbrain" when OPENBRAIN_URL + OPENBRAIN_API_KEY are also set.
# OPENBRAIN_URL: base URL of the EU-hosted OpenBrain FastAPI service.
# OPENBRAIN_API_KEY: shared secret sent as X-OpenBrain-Key (server-only; the
# browser never reaches OpenBrain directly).
SUPPORT_BACKEND=""
OPENBRAIN_URL=""
OPENBRAIN_API_KEY=""

# ---------------------------------------------------------------------------
# Newsletter (erp PLAN.md 13.11, Odoo module incutec_catalog_api)
# ---------------------------------------------------------------------------
# Posts are Markdown in content/posts/ and render from this repository. The
# footer signup form (app/lib/growth/odoo-newsletter.ts) starts a double
# opt-in subscription on Odoo's "Newsletter" mailing.list: Odoo mails the
# confirmation link itself and owns unsubscribing (its own mailing link).
# Nothing here talks to a shop or holds subscriber data.

# Base URL of the Odoo instance. Defaults to https://erp.incutec.eu.
NEWSLETTER_ODOO_URL=""
# Shared secret sent as X-Newsletter-Dispatch-Secret. Must match system
# parameter incutec_catalog_api.newsletter_dispatch_secret on that Odoo
# instance (set from env NEWSLETTER_DISPATCH_SECRET by
# erp/config/configure.py --section catalog_api). Keep as a secret.
NEWSLETTER_DISPATCH_SECRET=""

# ---------------------------------------------------------------------------
# Financial goal meter (optional)
# ---------------------------------------------------------------------------
# Aggregate order totals for `npm run goals:update`, as
#   {"orders": 12, "revenue_eur": 842.5, "updated_at": "2026-09-14T10:00:00Z"}
# The Odoo endpoint that serves this is ERP PLAN.md step 12.6; until it
# exists the script reports the missing source and writes nothing.
GOALS_URL=""

# ---------------------------------------------------------------------------
# Ops (optional)
# ---------------------------------------------------------------------------
# Bearer token for the daily support-cleanup workflow
# (.github/workflows/support-cleanup.yml). Must match the repo secret of
# the same name. Without it /api/support/cleanup refuses to run.
SUPPORT_CLEANUP_SECRET=""

# Bearer token for /api/support/relay, the outbound half of the support
# bridge: Odoo posts a staff member's public ticket comment here and the
# Worker writes it into the Discord support thread. Must match system
# parameter incutec_support.relay_token on the Odoo instance (set from
# env SUPPORT_RELAY_SECRET by erp/config/support.py). Without it the
# route returns 503 and nothing is relayed. Keep as a secret.
SUPPORT_RELAY_SECRET=""
