# OpenDrone storefront — environment variables
# Copy to .env before running `npm run dev`.
#
# Production reads its catalog from Shopify and stays a closed storefront until
# the founder's go; scripts/launch-preorders.mjs then opens it (README "Launch
# preorders").

# ---------------------------------------------------------------------------
# Required — storefront cannot boot without this
# ---------------------------------------------------------------------------

# Random string used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="your-session-secret"

# Checkout gate: anything but 1 keeps the cart closed. Production sets it in
# wrangler.production.toml [vars]; scripts/launch-preorders.mjs flips it to 1
# at launch.
SHOPIFY_CHECKOUT_WRITE_ENABLED="0"
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_TOKEN=""
SHOPIFY_STOREFRONT_API_VERSION="2026-07"
SHOPIFY_CHECKOUT_DOMAIN=""
# Exact HTTPS account URL copied from Shopify's customer-account setup. When
# unset, account links are hidden and legacy /account routes fail closed.
SHOPIFY_CUSTOMER_ACCOUNT_URL=""
# Shopify owns newsletter consent and unsubscribe. This separate gate may be
# 1 while checkout remains closed. Existing UNSUBSCRIBED consent is preserved.
SHOPIFY_NEWSLETTER_WRITE_ENABLED="1"
# Admin API token. Newsletter consent needs the customer scopes; preorder
# campaign counts need read_orders, plus read_all_orders once a campaign runs
# longer than 60 days. Without order access, campaign SKUs close.
SHOPIFY_ADMIN_API_TOKEN=""
SHOPIFY_ADMIN_API_VERSION="2026-07"
# Writes each preorder price step to Shopify. Needs write_products on the
# admin token. Anything but 1 leaves Shopify alone and campaign SKUs priced
# under their step close. Production only: staging shares the Shopify store.
SHOPIFY_PRICE_TIER_WRITE_ENABLED="0"
# Shopify webhook signing secret for orders/paid: the OpenDrone Infra app's
# client secret, since that app registers the webhook. Without it the webhook
# route answers 503 and only the scheduled reconcile steps a price. The launch
# script copies this value to the production Worker secret.
SHOPIFY_WEBHOOK_SECRET=""
# Staging only: HTTP basic auth password (user "opendrone") in front of the
# whole Worker. Unset in production.
STAGING_PASSWORD=""
# Must be 1 only after the store's tax display has been verified.
SHOPIFY_PRICES_INCLUDE_VAT=""
# Per-SKU sale policy, required for every published Shopify SKU. Before launch
# production entries are sold_out with a null ship promise; the launch script
# sets the SKUs in content/preorders.json to preorder (the campaign sets their
# ship promise) and keeps every other SKU sold_out. It does not claim InvenTree
# availability.
# SHOPIFY_PREVIEW_POLICY_JSON='{"EXAMPLE-SKU":{"saleMode":"sold_out","shipPromise":null}}'

# ---------------------------------------------------------------------------
# Legal entity: footer, imprint, invoices.
# WER Art. VI.45 requires these to appear on every page of a BE webshop.
# ---------------------------------------------------------------------------
PUBLIC_COMPANY_NAME="Incutec BV"
PUBLIC_COMPANY_ADDRESS="Stapelhuisstraat 15, 3000 Leuven, Belgium"
PUBLIC_COMPANY_KBO="1038.934.039"   # BCE/KBO enterprise number
PUBLIC_COMPANY_VAT="BE 1038.934.039" # Same digits, BE-prefixed
PUBLIC_COMPANY_EMAIL="contact@opendrone.be"
PUBLIC_COMPANY_TEL="[pending]"      # Optional but recommended

# ---------------------------------------------------------------------------
# Launch switches (optional)
# ---------------------------------------------------------------------------
# Coming-soon kill switch: unset (or anything but "0") renders every product
# as coming soon: no prices, notify-me signup instead of add-to-cart.
# Production sets it in wrangler.production.toml [vars];
# scripts/launch-preorders.mjs sets it to "0" at launch. A per-product
# "idea" or "development" status in content/products/*.json wins over it.
# PUBLIC_COMING_SOON="1"

# ---------------------------------------------------------------------------
# Native public support
# ---------------------------------------------------------------------------
# /support links directly to this invite and PUBLIC_COMPANY_EMAIL. The retired
# custom ticket API returns 410 and has no runtime credentials.
DISCORD_SUPPORT_INVITE="https://discord.gg/ABajnacUsS"
PUBLIC_DISCORD_INVITE="https://discord.gg/ABajnacUsS"

# ---------------------------------------------------------------------------
# Roadmap API headroom (optional)
# ---------------------------------------------------------------------------
# Fine-grained GitHub token with read access to public repository metadata.
GITHUB_STATUS_TOKEN=""
