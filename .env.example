# OpenDrone storefront: environment variables
# Copy to .env before running `npm run dev`.
#
# The catalog comes from Shopify. Checkout opens only when
# SHOPIFY_CHECKOUT_WRITE_ENABLED=1 and PUBLIC_COMING_SOON=0 (README "Open or
# close the shop"). Leave both closed for a local run.

# ---------------------------------------------------------------------------
# Required: the storefront cannot boot without this
# ---------------------------------------------------------------------------

# Random string used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="your-session-secret"

# Checkout gate: anything but 1 keeps the cart closed. Production and staging
# set it in their wrangler [vars].
SHOPIFY_CHECKOUT_WRITE_ENABLED="0"
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_TOKEN=""
SHOPIFY_STOREFRONT_API_VERSION="2026-07"
# Custom checkout hostname (for example the Shopify primary domain). Cart
# checkout URLs must point at this host or SHOPIFY_STORE_DOMAIN; any other
# origin is refused, so an open shop without it cannot add to cart when
# Shopify hands out checkout links on that domain.
SHOPIFY_CHECKOUT_DOMAIN=""
# Exact HTTPS account URL copied from Shopify's customer-account setup. When
# unset, account links are hidden and legacy /account routes fail closed.
SHOPIFY_CUSTOMER_ACCOUNT_URL=""
# Shopify owns newsletter consent and unsubscribe. This separate gate may be
# 1 while checkout remains closed. Existing UNSUBSCRIBED consent is preserved.
SHOPIFY_NEWSLETTER_WRITE_ENABLED="1"
# Admin API token. Newsletter consent needs the customer scopes; preorder
# campaign counts need read_orders, plus read_all_orders once a campaign runs
# longer than 60 days. Without order access, campaign SKUs close.
SHOPIFY_ADMIN_API_TOKEN=""
SHOPIFY_ADMIN_API_VERSION="2026-07"
# Writes each preorder price step to Shopify. Needs write_products on the
# admin token. Anything but 1 leaves Shopify alone and campaign SKUs priced
# under their step close. Production only: staging shares the Shopify store.
SHOPIFY_PRICE_TIER_WRITE_ENABLED="0"
# Shopify webhook signing secret for orders/paid: the OpenDrone Infra app's
# client secret, since that app registers the webhook. Without it the webhook
# route answers 503 and only the scheduled reconcile steps a price. Production
# holds it as a Worker secret.
SHOPIFY_WEBHOOK_SECRET=""
# Staging only: HTTP basic auth password (user "opendrone") in front of the
# whole Worker. Unset in production.
STAGING_PASSWORD=""
# Must be 1 only after the store's tax display has been verified.
SHOPIFY_PRICES_INCLUDE_VAT=""
# Per-SKU sale policy, required for every published Shopify SKU: saleMode
# in_stock, preorder or sold_out, and shipPromise (null for sold_out and for
# a campaign SKU, whose promise comes from content/preorders.json). A SKU
# without an entry fails the catalog closed. It does not claim InvenTree
# availability.
# SHOPIFY_PREVIEW_POLICY_JSON='{"EXAMPLE-SKU":{"saleMode":"sold_out","shipPromise":null}}'

# ---------------------------------------------------------------------------
# Legal entity: footer, imprint, invoices.
# WER Art. VI.45 requires these to appear on every page of a BE webshop.
# ---------------------------------------------------------------------------
PUBLIC_COMPANY_NAME="Incutec BV"
PUBLIC_COMPANY_ADDRESS="Stapelhuisstraat 15, 3000 Leuven, Belgium"
PUBLIC_COMPANY_KBO="1038.934.039"   # BCE/KBO enterprise number
PUBLIC_COMPANY_VAT="BE 1038.934.039" # Same digits, BE-prefixed
PUBLIC_COMPANY_EMAIL="contact@opendrone.be"
PUBLIC_COMPANY_TEL="[pending]"      # Optional but recommended

# ---------------------------------------------------------------------------
# Shop switch (optional)
# ---------------------------------------------------------------------------
# Coming-soon kill switch: unset (or anything but "0") renders every product
# as coming soon: no prices, notify-me signup instead of add-to-cart.
# Production and staging set it in their wrangler [vars]. A per-product
# "idea" or "development" status in content/products/*.json wins over it.
# PUBLIC_COMING_SOON="1"

# ---------------------------------------------------------------------------
# Support tickets (README "Support")
# ---------------------------------------------------------------------------
# Tickets need the SUPPORT_DB D1 binding (wrangler.toml; locally
# `npm run db:migrate:local`), a Discord bot and a signing secret. Without
# them /support says tickets are unavailable.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
# Text channel (private thread per ticket) or staff-only forum (post per ticket).
DISCORD_SUPPORT_CHANNEL_ID=""
# Optional staff-only channel for the email and Shopify admin link of each ticket.
DISCORD_STAFF_METADATA_CHANNEL_ID=""
# Role mentioned into every ticket thread; moderators for SUPPORT_MODERATION_MODE.
SUPPORT_MOD_ROLE_ID=""
# enforce (a moderator reacts ✅ before a reply reaches the customer), log or off.
SUPPORT_MODERATION_MODE="off"
# Signs resume links and the od_support cookie: openssl rand -hex 32
SUPPORT_SESSION_SECRET=""
# Bearer token for POST /api/support/cleanup.
SUPPORT_CLEANUP_SECRET=""
# 1 tags the matched Shopify customer `support` and writes support.tickets.
SUPPORT_SHOPIFY_WRITE_ENABLED="0"
# 1 emails "new reply" notices (link only) through Resend. Founder's go needed.
SUPPORT_EMAIL_NOTIFY_ENABLED="0"
# Turnstile for the support and newsletter forms. Local runs without a secret
# may set SUPPORT_TURNSTILE_DEV_SKIP=1 (ignored in a build).
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Resend, for the trade form and (when enabled) reply notices.
RESEND_API_KEY=""
SUPPORT_FROM_EMAIL="support@opendrone.be"
# Community invite linked from /support and the footer.
DISCORD_SUPPORT_INVITE="https://discord.gg/ABajnacUsS"
PUBLIC_DISCORD_INVITE="https://discord.gg/ABajnacUsS"
# Dev server only: point Discord and Shopify Admin calls at
# `npm run support:sandbox -- --write-env` (it writes .env.local).
# SUPPORT_DEV_DISCORD_API="http://localhost:5196/discord"
# SUPPORT_DEV_SHOPIFY_ADMIN_URL="http://localhost:5196/shopify"

# ---------------------------------------------------------------------------
# Roadmap API headroom (optional)
# ---------------------------------------------------------------------------
# Fine-grained GitHub token with read access to public repository metadata.
GITHUB_STATUS_TOKEN=""
