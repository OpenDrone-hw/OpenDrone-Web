# Local board-art manifest: maps product handles to absolute paths of
# KiCad sources that live outside this (public) repo. Machine-specific —

# iCloud Drive collision-rename pattern: when iCloud detects two
# concurrent edits to the same file, it renames the loser to "<name> 2.<ext>".
# These dupes are never wanted in git. Pattern matches "<basename> 2.<ext>"
# (a literal " 2" before the extension).
* 2.*
* 2
*\ 2.*
*\ 2

# Local cache for scripts/publish-post.mjs (Shopify Files CDN URLs)
scripts/.post-uploads.json

# mobile audit screenshots (local only)
.mobile-audit/
# perf lab reports (scripts/lh-audit.mjs, scripts/perf-audit.mjs --out)
.lh/
.perf/

# Obsidian vault config — local note-taking, not part of the app
.obsidian/

# Throwaway hero-asset forensics (machine-specific absolute paths)
scripts/hero-assets/_forensic_*.mjs

