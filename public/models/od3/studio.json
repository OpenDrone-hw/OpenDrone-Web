  "_beatNote": "select is {none} or {group}: a group id from explode.json (fc, esc, rx, motor, frame, video). The scene focuses those parts: camera eases to them, the rest dims. caption is the beginner explainer under the note, hint a one-line 'connects to', href the product page; handle pulls the caption and link from the product's What-does-this-do content.",
  "beats": [
    {
      "id": "whole",
      "title": "OpenDrone 3\"",
      "note": "3\" freestyle build",
      "select": {
        "none": true
      }
    },
    {
