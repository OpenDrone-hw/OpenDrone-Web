{
  "name": "OpenDrone 3\"",
  "lighting": {
    "exposure": 1.15,
    "environment": 0.7,
    "ambient": 0.3,
    "background": "#0a0c0f",
    "key": {
      "power": 3.2,
      "azimuth": 89,
      "elevation": 46,
      "colour": "#e69728"
    },
    "fill": {
      "power": 1.0,
      "azimuth": 135,
      "elevation": 36,
      "colour": "#e5f7de"
    },
    "rim": {
      "power": 2.6,
      "azimuth": 283,
      "elevation": 31,
      "colour": "#cfe2ff"
    },
    "bounce": {
      "power": 0.3,
      "colour": "#7d7417"
    }
  },
  "spotlight": {
    "power": 14,
    "beam": 0.44,
    "strike": 0.27,
    "coneAngle": 26,
    "softness": 0.6,
    "sideAngle": 35,
    "height": 0.48,
    "darkenRest": 0.85,
    "dimLights": 0.12,
    "shrinkDrone": 0.55,
    "stageLeft": 0.28,
    "boardTilt": 0.04,
    "stageLift": -0.06,
    "colour": "#ffd7a0",
    "beamColour": "#ffcf96",
    "beamGain": 4
  },
  "sequence": {
    "speed": 0.85,
    "hold": 8.4,
    "travel": 4.6,
    "partSize": 0.5,
    "inspectSpin": 0,
    "autoOrbit": 0,
    "_note": "travel and hold are timeline units, not seconds: they set the SHAPE of a transition (how much of it the part spends flying versus held under the spotlight). scroll.springHz sets the SPEED. speed/autoOrbit/inspectSpin are read by the studio's autoplay; the hero drives position from the scroll spring instead and ignores speed."
  },
  "_materialNote": "match is a regex tried against the normalised occurrence name. Order matters; the last entry should be a catch-all. Board substrate is matched by suffix before any of these.",
